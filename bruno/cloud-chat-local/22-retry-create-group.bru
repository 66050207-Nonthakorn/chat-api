meta {
  name: 22-retry-create-group
  type: http
  seq: 22
}

post {
  url: {{baseUrl}}/api/v1/rooms
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Local-Test-User-ID: {{userAId}}
}

body:json {
  {
    "kind": "group",
    "title": "{{newGroupTitle}}",
    "member_ids": [],
    "request_id": "{{groupCreateRequestId}}"
  }
}

tests {
  test("retry returns the original group", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().replayed).to.equal(true);
    expect(res.getBody().room_id).to.equal(bru.getVar("createdGroupRoomId"));
  });
}
