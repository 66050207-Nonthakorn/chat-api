meta {
  name: 06-sync-as-demo-b
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/v1/rooms/{{groupRoomId}}/sync?after_seq=0
  body: none
  auth: none
}

headers {
  X-Local-Test-User-ID: {{userBId}}
}

tests {
  test("Demo B can recover the persisted message", function () {
    const body = res.getBody();
    expect(res.getStatus()).to.equal(200);
    expect(body.items).to.be.an("array");
    expect(body.items.some(function (message) {
      return message.client_message_id === "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa";
    })).to.equal(true);
  });
}
