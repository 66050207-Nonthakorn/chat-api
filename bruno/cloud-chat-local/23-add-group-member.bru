meta {
  name: 23-add-group-member
  type: http
  seq: 23
}

post {
  url: {{baseUrl}}/api/v1/rooms/{{createdGroupRoomId}}/members
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Local-Test-User-ID: {{userAId}}
}

body:json {
  {
    "member_ids": ["{{userBId}}"],
    "request_id": "{{groupAddRequestId}}"
  }
}

tests {
  test("owner adds Demo B or replays the addition", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().room_id).to.equal(bru.getVar("createdGroupRoomId"));
    expect(res.getBody().replayed).to.be.a("boolean");
  });
}
