meta {
  name: 07-read-history-as-demo-a
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/api/v1/rooms/{{groupRoomId}}/messages?limit=50
  body: none
  auth: none
}

headers {
  X-Local-Test-User-ID: {{userAId}}
}

tests {
  test("Demo A can read room history", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().items).to.be.an("array");
  });
}
