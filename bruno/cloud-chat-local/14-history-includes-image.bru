meta {
  name: 14-history-includes-image
  type: http
  seq: 14
}

get {
  url: {{baseUrl}}/api/v1/rooms/{{groupRoomId}}/messages?limit=100
  body: none
  auth: none
}

headers {
  X-Local-Test-User-ID: {{userAId}}
}



tests {
  test("history retains image metadata", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().items.some(m => m.image && m.image.url === bru.getVar("sentImageUrl"))).to.equal(true);
  });
}
