APP_ENV=local
ENABLE_LOCAL_TEST_IDENTITY=true
DATABASE_URL=postgres://chat:chat@localhost:5432/chat?sslmode=disable
VALKEY_URL=redis://localhost:6379/0
HTTP_ADDR=127.0.0.1:8080
AWS_REGION=us-east-1
IMAGE_BUCKET=cloudchat-images
IMAGE_ENDPOINT=http://localhost:8333
IMAGE_ACCESS_KEY=admin
IMAGE_SECRET_KEY=secret
IMAGE_MESSAGES_ENABLED=true
# Required in production; local mode has a built-in development-only key.
CURSOR_HMAC_KEY=
